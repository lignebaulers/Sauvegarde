<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="Guidage lignes TEC" xmlns="http://www.topografix.com/GPX/1/1" xmlns:osmand="https://osmand.net">
<metadata><name>Depot_vers_Soignies-Hopital_NOTE71</name><desc>Voyage à vide vers le départ de la 71 (Soignies Hôpital), selon la note « Ligne 71 – HLP : suivre le plan » (chaussée de Braine fermée après l'Hôpital). Dépôt &gt; E19 &gt; A501 &gt; N57 ; rond-point Salmonsart : continuer la N57 ; rond-point Biamont : à gauche chaussée d'Enghien ; Bd Kennedy/Roosevelt jusqu'à la gare ; puis rue de la Station, rue Neuve, chaussée de Braine jusqu'à l'Hôpital, puis demi-tour au petit rond-point de l'entrée des urgences (à droite, ~100 m après l'arrêt) pour te mettre à l'arrêt de départ. Partie dépôt &gt; Soignies calculée, à confirmer.</desc></metadata>
<wpt lat="50.590009" lon="4.093405"><name>Rond-point Salmonsart : continuer la N57 (chaussée de Braine FERMÉE)</name><type>Dépôt</type><extensions><osmand:icon>special_arrow_right</osmand:icon><osmand:color>#9c27b0</osmand:color></extensions></wpt>
<wpt lat="50.593767" lon="4.062206"><name>Rond-point Biamont : à gauche chaussée d'Enghien</name><type>Dépôt</type><extensions><osmand:icon>special_arrow_left</osmand:icon><osmand:color>#9c27b0</osmand:color></extensions></wpt>
<wpt lat="50.581471" lon="4.068413"><name>Bd Kennedy : à droite vers la gare</name><type>Dépôt</type><extensions><osmand:icon>special_arrow_right</osmand:icon><osmand:color>#9c27b0</osmand:color></extensions></wpt>
<wpt lat="50.573084" lon="4.068275"><name>Gare : continuer rue de la Station / rue Neuve vers l'Hôpital</name><type>Dépôt</type><extensions><osmand:icon>special_arrow_up</osmand:icon><osmand:color>#9c27b0</osmand:color></extensions></wpt>
<wpt lat="50.581908" lon="4.078206"><name>Arrivée : SOIGNIES Hôpital (départ 71)</name><type>Dépôt</type><extensions><osmand:icon>special_flag_finish</osmand:icon><osmand:color>#9c27b0</osmand:color></extensions></wpt>
<wpt lat="50.582005" lon="4.080021"><name>Demi-tour : petit rond-point de l'entrée des urgences (à droite), puis ressortir à gauche vers l'arrêt Hôpital (départ)</name><type>Dépôt</type><extensions><osmand:icon>special_arrow_uturn</osmand:icon><osmand:color>#9c27b0</osmand:color></extensions></wpt>
<trk><name>Depot_vers_Soignies-Hopital_NOTE71</name><desc>Voyage à vide vers le départ de la 71 (Soignies Hôpital), selon la note « Ligne 71 – HLP : suivre le plan » (chaussée de Braine fermée après l'Hôpital). Dépôt &gt; E19 &gt; A501 &gt; N57 ; rond-point Salmonsart : continuer la N57 ; rond-point Biamont : à gauche chaussée d'Enghien ; Bd Kennedy/Roosevelt jusqu'à la gare ; puis rue de la Station, rue Neuve, chaussée de Braine jusqu'à l'Hôpital, puis demi-tour au petit rond-point de l'entrée des urgences (à droite, ~100 m après l'arrêt) pour te mettre à l'arrêt de départ. Partie dépôt &gt; Soignies calculée, à confirmer.</desc><extensions><osmand:color>#9c27b0</osmand:color></extensions><trkseg>
