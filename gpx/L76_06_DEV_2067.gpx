<wpt lat="50.610169" lon="4.336421"><name>05 BAULERS Chaussée de Bruxelles</name><type>Arrêts déviation</type><extensions><osmand:icon>highway_bus_stop</osmand:icon><osmand:background>circle</osmand:background><osmand:color>#e30613</osmand:color></extensions></wpt>
