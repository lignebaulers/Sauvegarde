<wpt lat="50.600873" lon="4.335579"><name>07 NIVELLES Rue Willame (Gare)</name><type>Arrêts déviation</type><extensions><osmand:icon>highway_bus_stop</osmand:icon><osmand:background>circle</osmand:background><osmand:color>#e30613</osmand:color></extensions></wpt>
